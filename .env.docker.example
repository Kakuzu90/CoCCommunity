# Copy the relevant keys into src/.env after creating the Laravel app.
# These match the docker-compose service names and the no-Redis decision.

APP_URL=http://localhost:8080

# --- Database (Postgres container) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=coc
DB_USERNAME=coc
DB_PASSWORD=secret

# --- No Redis: database-backed cache, queue, sessions ---
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# --- Mail (Mailpit container) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@clashcommons.test

# --- Object storage ---
# Local dev: MinIO container (S3-compatible, presigned URLs behave the same).
# Staging/production: Cloudflare R2 — same keys, different values. No code change.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clashcommons-media
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/clashcommons-media
AWS_USE_PATH_STYLE_ENDPOINT=true
# The app signs URLs against http://minio:9000, which a browser on the host cannot resolve.
# MediaUrlResolver rewrites the host of generated URLs to this value when it is set.
# Leave it EMPTY in staging/production — R2 is reachable at one address from everywhere.
MEDIA_PRESIGN_HOST=http://localhost:9000

# Production values look like this instead:
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.<domain>            # cookieless CDN origin, public/ + game/ only

# --- Clash of Clans API (server-side, IP-bound key) ---
# Leave COC_API_TOKEN empty locally: the app binds FakeCocApiClient and serves
# recorded fixtures, so no key and no IP allowlisting is needed for development.
COC_DRIVER=fake
COC_API_TOKEN=
COC_API_BASE_URL=https://api.clashofclans.com/v1

# --- Vite (node container) ---
VITE_PORT=5173

# --- MinIO container (local only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
