# Copy the relevant keys into src/.env after creating the Laravel app.
# These match the docker-compose service names and the no-Redis decision.

APP_URL=http://localhost:8080

# --- Database (Postgres container) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=coc
DB_USERNAME=coc
DB_PASSWORD=secret

# --- No Redis: database-backed cache, queue, sessions ---
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# --- Mail (Mailpit container) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@clashcommons.test

# --- Object storage: Cloudflare R2 (S3-compatible). Fill in real values. ---
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Clash of Clans API (server-side, IP-bound key) ---
COC_API_TOKEN=
COC_API_BASE_URL=https://api.clashofclans.com/v1

# --- Vite (node container) ---
VITE_PORT=5173
